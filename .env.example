# Sinar Clothing — Supabase connection
# Copy this file to ".env" and fill in the real values, then restart `npm run dev`.
# Set the SAME two variables in Vercel (Project → Settings → Environment Variables)
# so the LIVE site shows real products instead of the demo fallback.
#
# The URL is fixed for the Sinar project:
VITE_SUPABASE_URL=https://gmnjvcqdkdsikiysaoyq.supabase.co
#
# Get the PUBLISHABLE (anon) key from:
#   Supabase dashboard → project gmnjvcqdkdsikiysaoyq → Project Settings → API → Project API keys → "anon / publishable"
#   (NOT the service_role / secret key — never put a secret key in a VITE_ variable, it ships to the browser.)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
